# Copy to .env.development.local for local work (never commit the copy).

# Neon connection string, e.g. the "dev" branch. Leave empty to build from src/data only.
DATABASE_URL=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRETS_KEY=
# Netlify build hook for the Publish button (usually only set on Netlify).
NETLIFY_BUILD_HOOK=

# Local only: open /admin as this existing account without signing in. Leave empty to test sign-in.
DEV_ADMIN_EMAIL=
# Base address for links printed by `npm run db:dev -- invite`.
SITE_URL=http://localhost:4321
