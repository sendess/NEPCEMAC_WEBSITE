---
import { Font } from 'astro:assets';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import Lightbox from '~/components/Lightbox.astro';
import BackToTop from '~/components/BackToTop.astro';
import { org } from '~/data/site';
import { getLangFromUrl, localizePath, stripLang, useTranslations, type Lang } from '~/i18n/utils';

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = org.description[lang], noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${org.name[lang]}` : `${org.name[lang]} — ${org.legalName[lang]}`;
const basePath = stripLang(Astro.url.pathname);
const canonical = new URL(localizePath(basePath, lang), Astro.site);
const alternates = (['en', 'ne'] as const).map((l) => ({ lang: l, href: new URL(localizePath(basePath, l), Astro.site).href }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: org.legalName.en,
  alternateName: [org.name.en, org.legalName.ne, org.name.ne],
  slogan: org.motto.en,
  url: Astro.site?.href,
  logo: new URL('/images/logo-208.webp', Astro.site).href,
  email: org.email,
  telephone: org.phones.map((p) => `+977-${p.replace(/^0/, '')}`),
  foundingDate: org.foundedOn,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Bagdol Road',
    addressLocality: 'Lalitpur',
    postalCode: '44600',
    addressCountry: 'NP',
  },
  sameAs: [org.facebook],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical.href} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#246414" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={org.legalName[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
    <meta property="og:locale" content={lang === 'ne' ? 'ne_NP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-display" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('site.skip')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Lightbox lang={lang} />
    <BackToTop label={t('common.backToTop')} />
  </body>
</html>
