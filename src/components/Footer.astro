---
import Icon from './Icon.astro';
import { circle, nav, org } from '~/data/site';
import { formatDigits, localizePath, telHref, tr, useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container top">
    <div class="about">
      <a class="logo-chip" href={localizePath('/', lang)} aria-label={t('site.home')}>
        <img src="/images/logo-104.webp" srcset="/images/logo-104.webp 1x, /images/logo-208.webp 2x" width="264" height="104" alt="NEPCEMAC" loading="lazy" />
      </a>
      <p class="legal-name">{tr(org.legalName, lang)}</p>
      <p>{t('footer.about')}</p>
      <div class="social">
        <a href={org.facebook} target="_blank" rel="noopener" aria-label={`${t('common.facebook')} ${t('common.opensNewTab')}`}>
          <Icon name="facebook" size={20} />
        </a>
        <a href={`https://www.youtube.com/watch?v=${org.documentaryId}`} target="_blank" rel="noopener" aria-label={`YouTube ${t('common.opensNewTab')}`}>
          <Icon name="youtube" size={20} />
        </a>
      </div>
    </div>

    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore">{t('footer.explore')}</h2>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={localizePath(item.href, lang)}>{t(`nav.${item.key}`)}</a>
            </li>
          ))
        }
        <li><a href={localizePath('/contact/', lang)}>{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <div>
      <h2>{t('footer.contact')}</h2>
      <ul class="contact">
        <li><Icon name="map-pin" size={18} /><span>{tr(org.address, lang)}</span></li>
        <li>
          <Icon name="phone" size={18} />
          <span>
            {org.phones.map((p, i) => (
              <>
                {i > 0 && ', '}
                <a href={telHref(p)}>{formatDigits(p, lang)}</a>
              </>
            ))}
          </span>
        </li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${org.email}`}>{org.email}</a></li>
        <li><Icon name="clock" size={18} /><span>{tr(org.hours, lang)}</span></li>
      </ul>
    </div>

    <div>
      <h2>{t('footer.circle')}</h2>
      <ul class="circle">
        {
          circle.map((c) => (
            <li>
              {c.href ? (
                <a href={c.href} target="_blank" rel="noopener">
                  {tr(c.name, lang)}
                </a>
              ) : (
                <span>{tr(c.name, lang)}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container bottom">
    <p>{t('footer.registered')}</p>
    <p>© {formatDigits(year, lang)} {tr(org.legalName, lang)} ({tr(org.name, lang)}). {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--green-950);
    color: #c9d6c4;
    font-size: var(--step--1);
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .top {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    padding-bottom: 2.5rem;
  }

  h2 {
    margin-bottom: 1rem;
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  :lang(ne) h2 {
    font-size: 1rem;
    letter-spacing: 0;
  }

  .about {
    display: grid;
    gap: 0.85rem;
    align-content: start;
    max-width: 380px;
  }

  .logo-chip {
    justify-self: start;
    padding: 0.55rem 0.8rem;
    border-radius: 14px;
    background: #fff;
  }

  .logo-chip img {
    height: 44px;
    width: auto;
  }

  .legal-name {
    color: #fff;
    font-weight: 600;
  }

  ul {
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  a {
    color: #e3ecdf;
    text-decoration: none;
  }

  a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .contact li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.6rem;
    align-items: start;
  }

  .contact :global(.icon) {
    margin-top: 0.2em;
    color: var(--green-300);
  }

  .social {
    display: flex;
    gap: 0.5rem;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.2);
  }

  .social a:hover {
    background: rgb(255 255 255 / 0.08);
    text-decoration: none;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem 1.75rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.85rem;
    color: #9fb09a;
  }

  @media (max-width: 900px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
