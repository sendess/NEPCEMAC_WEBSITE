---
// OpenStreetMap through Leaflet: free, no API key, loaded only when the map scrolls into view.
type Props = { lat: number; lng: number; label: string; ariaLabel: string };
const { lat, lng, label, ariaLabel } = Astro.props;
---

<div class="map" data-map data-lat={lat} data-lng={lng} data-label={label} role="region" aria-label={ariaLabel}></div>

<script>
  import 'leaflet/dist/leaflet.css';

  const boxes = document.querySelectorAll<HTMLElement>('[data-map]');
  const draw = async (box: HTMLElement) => {
    const L = await import('leaflet');
    const at: [number, number] = [Number(box.dataset.lat), Number(box.dataset.lng)];
    const map = L.map(box, { scrollWheelZoom: false }).setView(at, 16);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    const pin = L.divIcon({ className: 'map-pin', html: '<span></span>', iconSize: [34, 34], iconAnchor: [17, 34], popupAnchor: [0, -30] });
    L.marker(at, { icon: pin, title: box.dataset.label }).addTo(map).bindPopup(box.dataset.label ?? '').openPopup();
  };
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      io.unobserve(entry.target);
      draw(entry.target as HTMLElement);
    }
  }, { rootMargin: '200px' });
  boxes.forEach((b) => io.observe(b));
</script>

<style>
  .map {
    height: 100%;
    min-height: 360px;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--green-50);
    border: 1px solid var(--line);
    z-index: 0;
  }

  .map :global(.map-pin span) {
    display: block;
    width: 34px;
    height: 34px;
    border-radius: 50% 50% 50% 0;
    rotate: -45deg;
    background: var(--green);
    border: 3px solid #fff;
    box-shadow: 0 4px 10px rgb(0 0 0 / 0.3);
  }
</style>
