---
// One shared photo viewer. Any link with data-lightbox="group" opens here; links in the same group page through.
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const t = useTranslations(Astro.props.lang);
---

<dialog class="lightbox" data-lightbox-dialog data-label-of={t('common.photoOf')} aria-label={t('common.photos')}>
  <figure>
    <div class="stage">
      <img alt="" data-lightbox-img />
      <span class="spinner" data-lightbox-spinner role="status" aria-label={t('common.loading')}><Icon name="loader-circle" size={34} /></span>
    </div>
    <figcaption data-lightbox-caption></figcaption>
  </figure>
  <p class="count" data-lightbox-count aria-live="polite"></p>
  <button class="close" type="button" data-lightbox-close aria-label={t('common.close')}><Icon name="x" size={24} /></button>
  <button class="nav prev" type="button" data-lightbox-prev aria-label={t('common.previous')}><Icon name="chevron-left" size={28} /></button>
  <button class="nav next" type="button" data-lightbox-next aria-label={t('common.next')}><Icon name="chevron-right" size={28} /></button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lightbox-count]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]')!;
    const labelOf = dialog.dataset.labelOf ?? '{n} / {total}';
    const nepali = document.documentElement.lang === 'ne';
    const digits = (n: number) => (nepali ? String(n).replace(/\d/g, (d) => '०१२३४५६७८९'[Number(d)]) : String(n));
    let items: HTMLAnchorElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    // Warm the cache for the neighbouring photos so paging feels instant.
    const preload = (i: number) => {
      const link = items[(i + items.length) % items.length];
      if (link) new Image().src = link.href;
    };

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const link = items[index];
      const thumb = link.querySelector('img');
      dialog.classList.add('is-loading');
      img.onload = img.onerror = () => dialog.classList.remove('is-loading');
      img.src = link.href;
      img.alt = thumb?.alt ?? link.dataset.caption ?? '';
      if (img.complete) dialog.classList.remove('is-loading');
      caption.textContent = link.dataset.caption ?? thumb?.alt ?? '';
      count.textContent = items.length > 1 ? labelOf.replace('{n}', digits(index + 1)).replace('{total}', digits(items.length)) : '';
      prev.hidden = next.hidden = items.length < 2;
      if (items.length > 1) {
        preload(index + 1);
        preload(index - 1);
      }
    };

    const close = () => {
      dialog.close();
      img.removeAttribute('src');
      opener?.focus();
    };

    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lightbox]');
      if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      opener = link;
      items = [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lightbox="${CSS.escape(link.dataset.lightbox!)}"]`)];
      show(items.indexOf(link));
      dialog.showModal();
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lightbox-close]')!.addEventListener('click', close);
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && items.length > 1) show(index - 1);
      if (e.key === 'ArrowRight' && items.length > 1) show(index + 1);
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });

    // Swipe left/right on touch screens.
    let startX = 0;
    let startY = 0;
    dialog.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (items.length > 1 && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) show(index + (dx < 0 ? 1 : -1));
    });

    // Clicking the dark area around the photo closes the viewer.
    dialog.addEventListener('click', (e) => e.target === dialog && close());
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(3.5rem, 6vw, 4.5rem) clamp(0.75rem, 6vw, 5rem) 2.5rem;
    border: 0;
    background: rgb(8 18 6 / 0.95);
    color: #fff;
    touch-action: pan-y;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
    animation: fade-in 0.2s var(--ease);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  figure {
    margin: 0;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    max-height: 100%;
  }

  .stage {
    position: relative;
    display: grid;
    place-items: center;
    min-width: min(60vw, 320px);
    min-height: 200px;
  }

  img {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    border-radius: 10px;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.7);
    transition: opacity 0.25s var(--ease);
  }

  .is-loading img {
    opacity: 0.25;
  }

  .spinner {
    position: absolute;
    display: none;
    color: #cfe3c6;
  }

  .is-loading .spinner {
    display: block;
    animation: spin 0.9s linear infinite;
  }

  figcaption {
    max-width: 70ch;
    text-align: center;
    color: #dfe7db;
    line-height: 1.5;
  }

  .count {
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.1);
    color: #dfe7db;
    font-size: 0.9rem;
  }

  .count:empty {
    display: none;
  }

  button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
  }

  button:hover {
    background: rgb(255 255 255 / 0.18);
  }

  .close {
    top: 1rem;
    right: 1rem;
  }

  .nav {
    top: 50%;
    translate: 0 -50%;
  }

  .prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
  }

  .next {
    right: clamp(0.5rem, 2vw, 1.5rem);
  }

  @media (max-width: 640px) {
    .nav {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
</style>
