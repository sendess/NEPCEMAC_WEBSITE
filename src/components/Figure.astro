---
// A framed photo with an optional caption. By default it opens in the shared photo viewer.
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { largestPhoto } from '~/lib/photos';

type Props = {
  slug: string;
  alt: string;
  /** Text under the photo. `true` repeats the alt text; leave out for no caption. */
  caption?: string | boolean;
  /** CSS aspect ratio of the frame, e.g. "4 / 3". Leave out to fill the parent's height. */
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  zoom?: boolean;
  /** Photos that share a group page through together in the viewer. */
  group?: string;
  class?: string;
};

const { slug, alt, caption, ratio, sizes, priority = false, zoom = true, group, class: className } = Astro.props;
const text = caption === true ? alt : caption || '';
const Tag = zoom ? 'a' : 'div';
const linkProps = zoom ? { href: largestPhoto(slug), 'data-lightbox': group ?? `photo-${slug}`, 'data-caption': text || alt } : {};
---

<figure class:list={['figure', className]}>
  <Tag class="photo frame" style={ratio ? `aspect-ratio:${ratio}` : undefined} {...linkProps}>
    <Photo slug={slug} alt={alt} sizes={sizes} priority={priority} />
    {
      zoom && (
        <span class="zoom" aria-hidden="true">
          <Icon name="expand" size={16} />
        </span>
      )
    }
  </Tag>
  {text && <figcaption>{text}</figcaption>}
</figure>

<style>
  .figure {
    margin: 0;
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }

  .frame {
    display: block;
    height: 100%;
  }

  a.frame :global(img) {
    transition: scale 0.6s var(--ease);
  }

  a.frame:hover :global(img) {
    scale: 1.03;
  }

  .zoom {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgb(14 38 8 / 0.55);
    color: #fff;
    opacity: 0;
    translate: 0 4px;
    transition: opacity 0.2s var(--ease), translate 0.2s var(--ease);
  }

  a.frame:hover .zoom,
  a.frame:focus-visible .zoom {
    opacity: 1;
    translate: 0 0;
  }

  @media (hover: none) {
    .zoom {
      opacity: 0.9;
      translate: 0 0;
    }
  }

  figcaption {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  figcaption::before {
    content: '';
    flex: none;
    width: 14px;
    height: 2px;
    translate: 0 -0.3em;
    border-radius: 2px;
    background: var(--green-500);
  }
</style>
