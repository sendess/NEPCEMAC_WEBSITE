---
import { resolvePhoto, type PhotoRef } from '~/lib/photos';

type Props = {
  /** Slug of a photo in public/images/photos, or a photo uploaded in the admin panel. */
  slug: PhotoRef;
  alt: string;
  /** Rendered width hint for the browser, e.g. "(min-width: 900px) 50vw, 100vw". */
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  /** Override the stored focal point, e.g. "50% 20%". */
  position?: string;
};

const { slug, alt, sizes = '(min-width: 1200px) 600px, 100vw', class: className, loading = 'lazy', priority = false, position } = Astro.props;
const photo = resolvePhoto(slug);
// The average colour shows while the photo loads; the focal point keeps faces and banners in frame when cropped.
const style = `background-color:${photo.color};object-position:${position ?? photo.focus}`;
---

<img
  src={photo.src}
  srcset={photo.srcset}
  sizes={sizes}
  width={photo.width}
  height={photo.height}
  alt={alt}
  class={className}
  style={style}
  loading={priority ? 'eager' : loading}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
/>
