---
import { photoInfo, photoUrl } from '~/lib/photos';

type Props = {
  slug: string;
  alt: string;
  /** Rendered width hint for the browser, e.g. "(min-width: 900px) 50vw, 100vw". */
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  priority?: boolean;
  /** Override the stored focal point, e.g. "50% 20%". */
  position?: string;
};

const { slug, alt, sizes = '(min-width: 1200px) 600px, 100vw', class: className, loading = 'lazy', priority = false, position } = Astro.props;
const info = photoInfo(slug);
const srcset = info.widths.map((w) => `${photoUrl(slug, w)} ${w}w`).join(', ');
// Fallback for browsers without srcset: a mid-size copy.
const fallback = info.widths.find((w) => w >= 900) ?? info.widths.at(-1)!;
// The average colour shows while the photo loads; the focal point keeps faces and banners in frame when cropped.
const style = `background-color:${info.color};object-position:${position ?? info.focus}`;
---

<img
  src={photoUrl(slug, fallback)}
  srcset={srcset}
  sizes={sizes}
  width={info.width}
  height={info.height}
  alt={alt}
  class={className}
  style={style}
  loading={priority ? 'eager' : loading}
  decoding="async"
  fetchpriority={priority ? 'high' : undefined}
/>
