---
// "Compost doctor": pick a symptom, see why it happens and what to do. Tabs with JavaScript;
// without it every answer is listed one after another.
import Icon from './Icon.astro';
import { compostProblems, doctorCopy } from '~/data/tools';
import { localizePath, tr, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const dc = (k: keyof typeof doctorCopy) => tr(doctorCopy[k], lang);
const askHref = `${localizePath('/contact/', lang)}?type=programme#request`;
---

<div class="doctor" data-doctor>
  <div class="d-tabs" role="tablist" aria-label={dc('choose')} data-d-tabs hidden>
    {
      compostProblems.map((p, i) => (
        <button
          type="button"
          role="tab"
          id={`d-tab-${p.id}`}
          aria-controls={`d-${p.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-d-tab={p.id}
        >
          <span class="d-icon" aria-hidden="true">
            <Icon name={p.icon} size={20} />
          </span>
          <span>{tr(p.label, lang)}</span>
        </button>
      ))
    }
  </div>

  <div class="d-panels">
    {
      compostProblems.map((p) => (
        <section class="d-panel" id={`d-${p.id}`} role="tabpanel" aria-labelledby={`d-tab-${p.id}`} data-d-panel={p.id}>
          <h3 class="d-title">
            <span class="d-icon" aria-hidden="true">
              <Icon name={p.icon} size={22} />
            </span>
            {tr(p.label, lang)}
          </h3>
          <div class="d-why">
            <h4>{p.id === 'ready' ? dc('readyWhy') : dc('why')}</h4>
            <p>{tr(p.why, lang)}</p>
          </div>
          <div class="d-fix">
            <h4>{p.id === 'ready' ? dc('readyFix') : dc('fix')}</h4>
            <ol class="check-list">
              {p.fixes.map((f) => (
                <li>
                  <Icon name="check" size={16} />
                  <span>{tr(f, lang)}</span>
                </li>
              ))}
            </ol>
          </div>
        </section>
      ))
    }
  </div>

  <p class="d-stuck">
    <span>{dc('stuck')}</span>
    <a class="link-arrow" href={askHref}>{dc('ask')} <Icon name="arrow-right" size={16} /></a>
  </p>
</div>

<script>
  const STEPS: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };

  document.querySelectorAll<HTMLElement>('[data-doctor]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-d-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-d-panel]')];
    const select = (id: string, focus = false) => {
      for (const t of tabs) {
        const on = t.dataset.dTab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      }
      for (const p of panels) p.hidden = p.dataset.dPanel !== id;
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.dTab!));
      t.addEventListener('keydown', (e) => {
        const step = STEPS[e.key];
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length].dataset.dTab!, true);
      });
    });
    root.querySelector<HTMLElement>('[data-d-tabs]')!.hidden = false;
    root.classList.add('is-enhanced');
    select(tabs[0].dataset.dTab!);
  });
</script>

<style>
  .doctor {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 1.25rem;
    align-items: start;
  }

  .doctor:not(.is-enhanced) {
    grid-template-columns: minmax(0, 1fr);
  }

  .d-tabs {
    display: grid;
    gap: 0.5rem;
  }

  .d-tabs button {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 56px;
    padding: 0.55rem 0.9rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    background: #fff;
    color: var(--ink);
    font-weight: 600;
    text-align: start;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  .d-tabs button:hover {
    border-color: var(--green-300);
  }

  .d-tabs button[aria-selected='true'] {
    border-color: var(--green);
    background: var(--green-50);
    box-shadow: inset 4px 0 0 var(--green);
  }

  .d-tabs button:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  .d-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--green-50);
    color: var(--green);
  }

  [aria-selected='true'] .d-icon {
    background: var(--green);
    color: #fff;
  }

  .d-panels {
    display: grid;
    gap: 1rem;
  }

  .d-panel {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: #fff;
    box-shadow: var(--shadow-sm);
  }

  .d-title {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin: 0;
    font-size: var(--step-1);
  }

  .d-title .d-icon {
    width: 44px;
    height: 44px;
    background: var(--green);
    color: #fff;
  }

  .d-why,
  .d-fix {
    display: grid;
    gap: 0.4rem;
  }

  .d-panel h4 {
    margin: 0;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green-600);
  }

  :lang(ne) .d-panel h4 {
    font-size: 1rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .d-why p {
    color: var(--text);
  }

  .d-fix ol {
    margin: 0;
  }

  .d-stuck {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    align-items: center;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .doctor {
      grid-template-columns: minmax(0, 1fr);
    }

    /* A row of chips that scrolls sideways on phones. */
    .d-tabs {
      display: flex;
      overflow-x: auto;
      gap: 0.4rem;
      padding-bottom: 0.25rem;
      scrollbar-width: none;
    }

    .d-tabs button {
      flex: none;
      min-height: 46px;
      padding: 0.35rem 0.85rem 0.35rem 0.4rem;
      border-radius: 999px;
      white-space: nowrap;
    }

    .d-tabs button[aria-selected='true'] {
      box-shadow: none;
    }

    .d-tabs .d-icon {
      width: 32px;
      height: 32px;
      border-radius: 50%;
    }
  }
</style>
