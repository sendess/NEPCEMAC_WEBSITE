---
// Printable A4 kitchen poster. Always bilingual (Nepali first), whichever language the page is in.
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import PageHero from '~/components/PageHero.astro';
import { bins, sortItems, type Bin } from '~/data/sorting';
import { org } from '~/data/site';
import { formatDigits, localizePath, useTranslations, type Lang, type L } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);

const pick = (bin: Bin) => sortItems.filter((i) => i.bin === bin && i.poster);
const short = (s: string) => s.split(/\s[—(]/)[0].trim();

const tips: L[] = [
  { ne: 'दूध र दहीका प्याकेट पखालेर हाल्नुहोस्', en: 'Rinse milk and curd pouches' },
  { ne: 'कागज र कार्टुन सुक्खा राख्नुहोस्', en: 'Keep paper and cardboard dry' },
  { ne: 'फुटेको सिसा र प्याड बेरेर मात्र', en: 'Wrap broken glass and pads' },
];
---

<BaseLayout title={t('poster.title')} description={t('poster.lead')}>
  <div class="no-print">
    <PageHero eyebrow={t('finder.eyebrow')} title={t('poster.title')} lead={t('poster.lead')}>
      <div class="print-row">
        <button class="btn btn-primary" type="button" data-print><Icon name="printer" size={18} /> {t('poster.print')}</button>
        <a class="btn btn-outline" href={`${localizePath('/resources/', lang)}#finder`}>{t('finder.title')}</a>
      </div>
      <p class="small muted">{t('poster.tip')}</p>
    </PageHero>
  </div>

  <section class="poster-stage">
    <article class="poster" lang="ne">
      <header class="p-top">
        <img src="/images/logo-208.webp" alt="NEPCEMAC" width="528" height="208" />
        <div>
          <h1>फोहोर छुट्याऔँ, सफा सहर बनाऔँ</h1>
          <p lang="en">Sort your waste — keep our city clean</p>
        </div>
      </header>

      <div class="p-bins">
        {
          (['green', 'red'] as const).map((bin) => (
            <section class:list={['p-bin', `p-${bin}`]}>
              <h2>
                <span class="p-icon">
                  <Icon name="trash" size={30} />
                </span>
                <span>
                  {bins[bin].title.ne} — {bins[bin].short.ne}
                  <small lang="en">
                    {bins[bin].title.en} — {bins[bin].short.en}
                  </small>
                </span>
              </h2>
              <ul>
                {pick(bin).map((i) => (
                  <li>
                    <strong>{short(i.name.ne)}</strong>
                    <span lang="en">{short(i.name.en)}</span>
                  </li>
                ))}
              </ul>
              <p class="p-rule">{bin === 'green' ? 'कम्पोस्ट मल बन्छ · Becomes compost' : 'पुनःप्रशोधन हुन्छ · Can be recycled'}</p>
            </section>
          ))
        }
      </div>

      <section class="p-special">
        <h2>
          <Icon name="triangle-alert" size={26} />
          <span>
            {bins.special.title.ne} — {bins.special.short.ne}
            <small lang="en">{bins.special.title.en} — {bins.special.short.en}</small>
          </span>
        </h2>
        <ul>
          {pick('special').map((i) => (
            <li>
              <strong>{short(i.name.ne)}</strong>
              <span lang="en">{short(i.name.en)}</span>
            </li>
          ))}
        </ul>
        <p>कहिल्यै नजलाउनुहोस् · Never burn them</p>
      </section>

      <ul class="p-tips">
        {
          tips.map((tip) => (
            <li>
              <Icon name="check" size={20} />
              <span>
                {tip.ne}
                <small lang="en">{tip.en}</small>
              </span>
            </li>
          ))
        }
      </ul>

      <footer class="p-foot">
        <span>{org.motto.ne} · <span lang="en">{org.motto.en}</span></span>
        <span>
          {org.name.ne} (NEPCEMAC) · nepcemac.org.np · {formatDigits(org.phones[0], 'ne')}
        </span>
      </footer>
    </article>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => print());
</script>

<style>
  .print-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .poster-stage {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    padding-inline: var(--gutter);
    background: var(--bg);
  }

  /* Sizes use container units, so the preview and the printed A4 page share one layout. */
  .poster {
    container-type: inline-size;
    width: min(100%, 794px);
    aspect-ratio: 210 / 297;
    margin-inline: auto;
    display: grid;
    grid-template-rows: auto 1fr auto auto auto;
    gap: 2cqw;
    padding: 4.4cqw 4.6cqw;
    background: #fff;
    box-shadow: var(--shadow-lg);
    border-radius: 6px;
    font-family: var(--font-sans);
    color: var(--ink);
    line-height: 1.25;
  }

  .poster small {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 0.72em;
    line-height: 1.3;
  }

  .p-top {
    display: flex;
    align-items: center;
    gap: 4cqw;
    padding-bottom: 2.4cqw;
    border-bottom: 0.5cqw solid var(--green);
  }

  .p-top img {
    width: 30cqw;
    height: auto;
  }

  .p-top h1 {
    font-family: var(--font-sans);
    font-size: 5cqw;
    line-height: 1.2;
    color: var(--green-900);
  }

  .p-top p {
    font-size: 2.6cqw;
    font-weight: 600;
    color: var(--blue-700);
  }

  .p-bins {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3cqw;
  }

  .p-bin {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.6cqw;
    padding: 2.4cqw 2.8cqw;
    border-radius: 2.4cqw;
    border: 0.4cqw solid;
  }

  .p-bin h2,
  .p-special h2 {
    display: flex;
    align-items: center;
    gap: 2cqw;
    font-family: var(--font-sans);
    font-size: 3.2cqw;
    line-height: 1.25;
  }

  .p-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 7cqw;
    height: 7cqw;
    border-radius: 2cqw;
    color: #fff;
  }

  .p-icon :global(svg) {
    width: 4.4cqw;
    height: 4.4cqw;
  }

  .p-bin ul,
  .p-special ul {
    list-style: none;
    display: grid;
    align-content: start;
  }

  .p-bin li {
    display: grid;
    padding: 0.8cqw 0;
    border-top: 0.2cqw solid rgb(0 0 0 / 0.08);
  }

  .p-bin li strong,
  .p-special li strong {
    font-size: 2.45cqw;
  }

  .p-bin li span,
  .p-special li span {
    font-size: 1.8cqw;
    color: var(--muted);
  }

  .p-rule {
    font-weight: 700;
    font-size: 2.2cqw;
  }

  .p-green {
    border-color: var(--green-500);
    background: var(--green-50);
  }

  .p-green .p-icon {
    background: var(--green-500);
  }

  .p-green .p-rule {
    color: var(--green-800);
  }

  .p-red {
    border-color: var(--bucket-red);
    background: var(--bucket-red-50);
  }

  .p-red .p-icon {
    background: var(--bucket-red);
  }

  .p-red .p-rule {
    color: var(--bucket-red);
  }

  .p-special {
    display: grid;
    gap: 1.6cqw;
    padding: 2.6cqw 3cqw;
    border-radius: 2.4cqw;
    border: 0.4cqw dashed var(--hazard);
    background: var(--hazard-50);
  }

  .p-special h2 :global(svg) {
    flex: none;
    width: 5cqw;
    height: 5cqw;
    color: var(--hazard);
  }

  .p-special ul {
    grid-template-columns: repeat(4, 1fr);
    gap: 2cqw;
  }

  .p-special li {
    display: grid;
  }

  .p-special > p {
    font-weight: 700;
    font-size: 2.2cqw;
    color: var(--hazard);
  }

  .p-tips {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2cqw;
  }

  .p-tips li {
    display: flex;
    gap: 1.2cqw;
    align-items: flex-start;
    font-size: 2.2cqw;
    font-weight: 600;
  }

  .p-tips :global(svg) {
    flex: none;
    width: 3cqw;
    height: 3cqw;
    color: var(--green);
  }

  .p-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1cqw 3cqw;
    padding-top: 2cqw;
    border-top: 0.3cqw solid var(--line);
    font-size: 1.9cqw;
    color: var(--muted);
  }

  @media print {
    @page {
      size: A4;
      margin: 8mm;
    }

    .poster-stage {
      padding: 0;
      background: none;
    }

    /* Fit the page whatever the paper (A4 or Letter): as wide as possible without getting taller than the page. */
    .poster {
      width: min(100%, calc((100vh - 2mm) * 210 / 297));
      break-inside: avoid;
      box-shadow: none;
      border-radius: 0;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>
