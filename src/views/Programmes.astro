---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import Photo from '~/components/Photo.astro';
import PageHero from '~/components/PageHero.astro';
import PageNav from '~/components/PageNav.astro';
import { themes } from '~/data/programmes';
import { formatDigits, localizePath, tr, useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={t('programmes.title')} description={t('programmes.lead')}>
  <PageHero eyebrow={t('nav.programmes')} title={t('programmes.title')} lead={t('programmes.lead')} />
  <PageNav label={t('programmes.jump')} items={themes.map((theme) => ({ id: theme.id, label: tr(theme.title, lang) }))} />

  {
    themes.map((theme, i) => (
      <section class:list={['section', i % 2 === 0 ? 'section-white' : '']} id={theme.id} aria-labelledby={`${theme.id}-title`}>
        <div class="container">
          <div class:list={['theme-head', i % 2 === 1 && 'is-flipped']}>
            <div class="theme-text">
              <p class="eyebrow">
                {formatDigits(String(i + 1).padStart(2, '0'), lang)} / {formatDigits(String(themes.length).padStart(2, '0'), lang)}
              </p>
              <h2 id={`${theme.id}-title`}>{tr(theme.title, lang)}</h2>
              <p class="lead">{tr(theme.summary, lang)}</p>
            </div>
            <div class="photo theme-photo">
              <Photo slug={theme.photo} alt={tr(theme.photoAlt, lang)} sizes="(min-width: 1000px) 520px, 100vw" />
            </div>
          </div>

          <ul class:list={['programmes', theme.programmes.length === 1 && 'is-single']}>
            {theme.programmes.map((p) => (
              <li class="card card-pad programme" id={p.id}>
                <span class="icon-badge">
                  <Icon name={p.icon} size={24} />
                </span>
                <h3>{tr(p.title, lang)}</h3>
                <p>{tr(p.text, lang)}</p>
                {p.facts && (
                  <ul class="chip-list facts">
                    {p.facts.map((f) => (
                      <li class="chip chip-blue">{tr(f, lang)}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="section section-tint">
    <div class="container end">
      <h2>{t('home.cta.title')}</h2>
      <p class="lead">{t('home.cta.text')}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={localizePath('/contact/?type=programme#request', lang)}>{t('cta.workWithUs')} <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn-outline" href={localizePath('/activities/', lang)}>{t('cta.allActivities')}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .theme-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .is-flipped .theme-text {
    order: 2;
  }

  .theme-text {
    display: grid;
    gap: 0.85rem;
  }

  .theme-text h2 {
    font-size: var(--step-3);
  }

  .theme-photo {
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow);
  }

  .programmes {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: 1.25rem;
  }

  .programmes.is-single {
    grid-template-columns: minmax(0, 760px);
  }

  .programme {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .programme p {
    color: var(--muted);
  }

  .facts {
    margin-top: 0.25rem;
  }

  .end {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 760px;
  }

  .end h2 {
    font-size: var(--step-3);
  }

  @media (max-width: 860px) {
    .theme-head {
      grid-template-columns: 1fr;
    }
    .is-flipped .theme-text {
      order: 0;
    }
  }
</style>
