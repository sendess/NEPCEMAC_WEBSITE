---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import Photo from '~/components/Photo.astro';
import PageHero from '~/components/PageHero.astro';
import PageNav from '~/components/PageNav.astro';
import SortFinder from '~/components/SortFinder.astro';
import SectionHead from '~/components/SectionHead.astro';
import YouTube from '~/components/YouTube.astro';
import { publications, research, compostMethods } from '~/data/resources';
import { studies } from '~/data/partners';
import { caption } from '~/data/photos';
import { org } from '~/data/site';
import { formatDigits, localizePath, tr, useTranslations, type Lang } from '~/i18n/utils';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);

/** Publications have no PDFs yet, so the button opens the request form with the title filled in. */
const copyHref = (title: string) =>
  `${localizePath('/contact/', lang)}?type=copy&item=${encodeURIComponent(title)}#request`;
---

<BaseLayout title={t('resources.title')} description={t('resources.lead')}>
  <PageHero eyebrow={t('nav.resources')} title={t('resources.title')} lead={t('resources.lead')} />
  <PageNav
    label={t('pagenav.label')}
    items={[
      { id: 'finder', label: t('finder.eyebrow') },
      { id: 'composting', label: t('resources.nav.compost') },
      { id: 'publications', label: t('resources.pubsEyebrow') },
      { id: 'research', label: t('resources.researchEyebrow') },
      { id: 'documentary', label: t('home.video.eyebrow') },
    ]}
  />

  <!-- Which bucket? -->
  <section class="section section-white" id="finder">
    <div class="container">
      <div class="finder-head">
        <SectionHead eyebrow={t('finder.eyebrow')} title={t('finder.title')} intro={t('finder.intro')} />
        <a class="btn btn-outline poster-link" href={localizePath('/poster/', lang)}>
          <Icon name="printer" size={18} /> {t('finder.poster')}
        </a>
      </div>
      <SortFinder lang={lang} />
    </div>
  </section>

  <!-- Composting -->
  <section class="section" id="composting">
    <div class="container">
      <SectionHead eyebrow={t('resources.compostEyebrow')} title={t('resources.compostTitle')} intro={t('resources.compostIntro')} />
      <ol class="grid grid-3 methods">
        {
          compostMethods.map((m, i) => (
            <li class="card card-pad method">
              <span class="step">{formatDigits(i + 1, lang)}</span>
              <span class="icon-badge">
                <Icon name={m.icon} size={24} />
              </span>
              <h3>{tr(m.title, lang)}</h3>
              <p>{tr(m.text, lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Publications -->
  <section class="section section-white" id="publications">
    <div class="container">
      <SectionHead eyebrow={t('resources.pubsEyebrow')} title={t('resources.pubsTitle')} intro={t('resources.pubsIntro')} />
      <div class="pubs-grid">
        <ul class="pubs">
          {
            publications.map((p) => (
              <li class="pub">
                <span class="icon-badge icon-badge-blue">
                  <Icon name={p.icon} size={22} />
                </span>
                <div>
                  <h3>{tr(p.title, lang)}</h3>
                  <p>{tr(p.text, lang)}</p>
                </div>
                {p.file ? (
                  <a class="btn btn-outline btn-sm" href={p.file} download>
                    <Icon name="download" size={16} /> {t('cta.download')}
                  </a>
                ) : (
                  <a class="btn btn-outline btn-sm" href={copyHref(tr(p.title, lang))}>
                    <Icon name="mail" size={16} /> {t('cta.askCopy')}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
        <div class="pubs-side">
          <div class="photo"><Photo slug="publications" alt={caption('publications', lang)} sizes="360px" /></div>
          <div class="photo"><Photo slug="vermi-box" alt={caption('vermi-box', lang)} sizes="360px" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Research -->
  <section class="section" id="research">
    <div class="container research-grid">
      <div>
        <SectionHead eyebrow={t('resources.researchEyebrow')} title={t('resources.researchTitle')} />
        <ul class="research">
          {
            research.map((r) => (
              <li>
                <Icon name="flask-conical" size={18} />
                <span>
                  {tr(r.title, lang)}
                  {r.year && <span class="muted"> ({formatDigits(r.year, lang)})</span>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <SectionHead eyebrow={t('partners.studiesEyebrow')} title={t('resources.reportsTitle')} />
        <ul class="reports">
          {
            studies.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  <span class="r-year">{formatDigits(s.year, lang)}</span>
                  <span lang="en">{s.title}</span>
                  <Icon name="arrow-up-right" size={16} />
                </a>
              </li>
            ))
          }
        </ul>
        <p><a class="link-arrow" href={localizePath('/partners/#records', lang)}>{t('partners.studiesTitle')} <Icon name="arrow-right" size={16} /></a></p>
      </div>
    </div>
  </section>

  <!-- Video -->
  <section class="section section-blue" id="documentary">
    <div class="container video">
      <SectionHead eyebrow={t('home.video.eyebrow')} title={t('home.video.title')} intro={t('home.video.text')} align="center" />
      <YouTube id={org.documentaryId} title="NEPCEMAC documentary" playLabel={t('home.video.play')} />
    </div>
  </section>
</BaseLayout>

<style>
  .finder-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0 2rem;
  }

  .poster-link {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .methods {
    list-style: none;
  }

  .method {
    position: relative;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .method p {
    color: var(--muted);
  }

  .step {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-family: var(--font-head);
    font-size: 2.6rem;
    font-weight: 700;
    color: var(--green-100);
    line-height: 1;
  }

  .pubs-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2rem;
    align-items: start;
  }

  .pubs {
    list-style: none;
    display: grid;
  }

  .pub {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .pub:first-child {
    padding-top: 0;
  }

  .pub h3 {
    font-size: 1.05rem;
  }

  .pub p {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .pubs-side {
    display: grid;
    gap: 1rem;
  }

  .pubs-side .photo {
    aspect-ratio: 4 / 3;
  }

  .research-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .research-grid :global(.section-head) {
    margin-bottom: 1.5rem;
  }

  .research,
  .reports {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .research li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    background: #fff;
    border: 1px solid var(--line);
  }

  .research :global(.icon) {
    margin-top: 0.25em;
    color: var(--blue);
  }

  .reports a {
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    gap: 0.75rem;
    align-items: start;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-sm);
    background: #fff;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }

  .reports a:hover {
    border-color: var(--blue);
  }

  .r-year {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--blue-700);
  }

  .reports + p {
    margin-top: 1.25rem;
  }

  .video {
    max-width: 900px;
  }

  @media (max-width: 1000px) {
    .pubs-grid,
    .research-grid {
      grid-template-columns: 1fr;
    }
    .pubs-side {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .pub {
      grid-template-columns: auto 1fr;
    }
    .pub .btn {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
