---
import AdminLayout from '~/layouts/AdminLayout.astro';
import Icon from '~/components/Icon.astro';
import { formatAgo, formatWhen } from '~/lib/admin-format';
import { listRequests, requestCounts, REQUEST_STATUSES, REQUEST_TYPES, STATUS_TAG, type RequestStatus } from '~/lib/requests';

export const prerender = false;

const params = Astro.url.searchParams;
const status = params.get('status') ?? '';
const q = (params.get('q') ?? '').trim().slice(0, 80);
const page = Math.max(1, Number(params.get('page')) || 1);
const [counts, list] = await Promise.all([requestCounts(), listRequests({ status, q, page })]);
const pages = Math.max(1, Math.ceil(list.total / list.pageSize));

const tabs: { key: string; label: string; n: number }[] = [
  { key: '', label: 'All', n: counts.all },
  ...(Object.keys(REQUEST_STATUSES) as RequestStatus[]).map((k) => ({ key: k, label: REQUEST_STATUSES[k], n: counts[k] })),
];
const link = (changes: Record<string, string | number>) => {
  const next = new URLSearchParams({ ...(status && { status }), ...(q && { q }), ...Object.fromEntries(Object.entries(changes).map(([k, v]) => [k, String(v)])) });
  for (const [k, v] of [...next]) if (!v || (k === 'page' && v === '1')) next.delete(k);
  const s = next.toString();
  return `/admin/requests${s ? `?${s}` : ''}`;
};
---

<AdminLayout title="Requests" wide>
  <div class="toolbar">
    <nav class="tabs" aria-label="Filter by status">
      {
        tabs.map((t) => (
          <a href={link({ status: t.key, page: 1 })} aria-current={t.key === status ? 'page' : undefined}>
            {t.label} <span class="n">{t.n}</span>
          </a>
        ))
      }
    </nav>
    <form class="search" method="get" role="search" data-no-busy>
      {status && <input type="hidden" name="status" value={status} />}
      <input name="q" type="search" value={q} placeholder="Name, phone, reference…" aria-label="Search requests" />
      <button class="btn btn-outline btn-sm" type="submit"><Icon name="search" size={16} /> Search</button>
    </form>
  </div>

  {
    list.rows.length === 0 ? (
      <div class="empty">
        <Icon name="inbox" size={32} />
        <p>{q ? `No requests match “${q}”.` : 'No requests here yet.'}</p>
      </div>
    ) : (
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>From</th>
              <th>Request</th>
              <th>Contact</th>
              <th>Received</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {list.rows.map((r) => (
              <tr>
                <td>
                  <a class="row-link" href={`/admin/requests/${r.id}`}>{r.name}</a>
                  {r.org && <span class="sub">{r.org}</span>}
                </td>
                <td>
                  {REQUEST_TYPES[r.type]}
                  <span class="sub">
                    {r.ref}
                    {r.area && ` · ${r.area}`}
                    {r.note_count > 0 && ` · ${r.note_count} note${r.note_count === 1 ? '' : 's'}`}
                  </span>
                </td>
                <td>
                  {r.phone && <span class="nowrap">{r.phone}</span>}
                  {r.email && <span class="sub">{r.email}</span>}
                </td>
                <td class="nowrap" title={formatWhen(r.created_at)}>
                  {formatAgo(r.created_at)}
                </td>
                <td>
                  <span class:list={['tag', STATUS_TAG[r.status]]}>{REQUEST_STATUSES[r.status]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    pages > 1 && (
      <nav class="pager" aria-label="Pages">
        {page > 1 && <a class="btn btn-outline btn-sm" href={link({ page: page - 1 })}>Newer</a>}
        <span>
          Page {page} of {pages}
        </span>
        {page < pages && <a class="btn btn-outline btn-sm" href={link({ page: page + 1 })}>Older</a>}
      </nav>
    )
  }
</AdminLayout>

<style>
  .toolbar .tabs {
    margin: 0;
  }

  .search {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .search input {
    width: min(100%, 16rem);
  }

  .pager {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    color: var(--muted);
  }
</style>
