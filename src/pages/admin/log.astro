---
import AdminLayout from '~/layouts/AdminLayout.astro';
import { AUDIT_KINDS, describeAction, listAudit } from '~/lib/audit';
import { formatWhen } from '~/lib/admin-format';
import { listUsers } from '~/lib/users';

export const prerender = false;

const params = Astro.url.searchParams;
const kind = params.get('kind') ?? '';
const person = params.get('person') ?? '';
const page = Math.max(1, Number(params.get('page')) || 1);
const pageSize = 50;
const [{ rows, total }, users] = await Promise.all([listAudit({ kind, person, page, pageSize }), listUsers()]);
const pages = Math.max(1, Math.ceil(total / pageSize));
const names = new Map(users.map((u) => [u.email, u.name]));
const link = (p: number) => {
  const q = new URLSearchParams({ ...(kind && { kind }), ...(person && { person }), ...(p > 1 && { page: String(p) }) });
  return `/admin/log${q.size ? `?${q}` : ''}`;
};
const failed = new Set(['sign_in_failed', 'sign_in_blocked', 'code_failed', 'password_change_failed', 'publish_failed']);

/** Short device description from the browser's user agent. */
function device(ua: string | null): string {
  if (!ua) return '';
  const os = /Android/.test(ua) ? 'Android' : /iPhone|iPad/.test(ua) ? 'iPhone' : /Windows/.test(ua) ? 'Windows' : /Mac OS/.test(ua) ? 'Mac' : /Linux/.test(ua) ? 'Linux' : '';
  const browser = /Edg\//.test(ua) ? 'Edge' : /Chrome\//.test(ua) ? 'Chrome' : /Firefox\//.test(ua) ? 'Firefox' : /Safari\//.test(ua) ? 'Safari' : '';
  return [browser, os].filter(Boolean).join(' on ');
}
---

<AdminLayout title="Activity log" wide>
  <form class="filters" method="get" data-no-busy>
    <div class="field">
      <label for="kind">Show</label>
      <select id="kind" name="kind" onchange="this.form.submit()">
        <option value="">Everything</option>
        {Object.entries(AUDIT_KINDS).map(([k, label]) => <option value={k} selected={k === kind}>{label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="person">Person</label>
      <select id="person" name="person" onchange="this.form.submit()">
        <option value="">Everyone</option>
        {users.map((u) => <option value={u.email} selected={u.email === person}>{u.name || u.email}</option>)}
        <option value="system" selected={person === 'system'}>Command line / system</option>
      </select>
    </div>
    <noscript><button class="btn btn-outline btn-sm" type="submit">Filter</button></noscript>
    <p class="hint">{total} entr{total === 1 ? 'y' : 'ies'}. Entries can’t be edited or deleted.</p>
  </form>

  <div class="table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>When</th>
          <th>Who</th>
          <th>What</th>
          <th>Device</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td class="nowrap">{formatWhen(r.at)}</td>
              <td>
                {r.actor_email ? names.get(r.actor_email) || r.actor_email : 'system'}
                {r.actor_email && names.get(r.actor_email) && <span class="sub">{r.actor_email}</span>}
              </td>
              <td>
                <span class:list={{ bad: failed.has(r.action) }}>{describeAction(r.action)}</span>
                {r.label && <span class="sub">{r.label}</span>}
              </td>
              <td>
                {device(r.user_agent)}
                {r.ip && <span class="sub">{r.ip}</span>}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    pages > 1 && (
      <nav class="pager" aria-label="Pages">
        {page > 1 && <a class="btn btn-outline btn-sm" href={link(page - 1)}>Newer</a>}
        <span>
          Page {page} of {pages}
        </span>
        {page < pages && <a class="btn btn-outline btn-sm" href={link(page + 1)}>Older</a>}
      </nav>
    )
  }
</AdminLayout>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: end;
    margin-bottom: 1rem;
  }

  .filters .field {
    min-width: 12rem;
  }

  .bad {
    font-weight: 600;
    color: #b42318;
  }

  .pager {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    color: var(--muted);
  }
</style>
